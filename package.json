{
  "name": "battleship",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' --parallel dev",
    "dev:server": "bun --filter @battleship/server dev",
    "dev:web": "bun --filter @battleship/web dev",
    "build": "bun run build:server && bun run build:web",
    "build:server": "bun --filter @battleship/server build",
    "build:web": "bun --filter @battleship/web build",
    "typecheck": "./node_modules/@typescript/native/bin/tsc --noEmit --project tsconfig.check.json --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test packages apps",
    "test:coverage": "bun test --coverage packages apps",
    "test:e2e": "playwright test",
    "db:push": "drizzle-kit push --config apps/server/drizzle.config.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "latest",
    "@types/bun": "latest",
    "@types/node": "latest",
    "eslint": "9.39.2",
    "eslint-plugin-jsx-a11y": "latest",
    "eslint-plugin-react-hooks": "latest",
    "fast-check": "latest",
    "globals": "latest",
    "prettier": "latest",
    "prettier-plugin-tailwindcss": "latest",
    "drizzle-kit": "latest",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "6.0.2",
    "typescript-eslint": "8.66.0"
  }
}
