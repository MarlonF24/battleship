
# PostgreSQL DB. In Compose, the container database receives these values.
DB_USER=user
DB_PASSWORD=password
DB_NAME=battleship
DB_HOST=localhost # Overridden by Docker Compose in production to point to the PostgreSQL container.
DB_PORT=5432
DB_SSL=false

# Port on which the Bun/Elysia server listens. Defaults to 8000 when omitted.
SERVER_PORT=8000

# Port used only by Vite's development page. Defaults to 5173 when omitted.
VITE_PORT=5173

# Browser origins outside this deployment that may call the backend directly,
# separated by commas. So, for example the origin of the Vite development page at e.g. http://localhost:5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Server log verbosity: fatal, error, warn, info, debug, trace, or silent.
LOG_LEVEL=info

# Use development locally, test in automated tests, and production in Docker.
# Production makes the Bun server serve the compiled React application too.
NODE_ENV=development

# HTTP(S) origin that the Battleship server uses to reach the hub server.
# Results are posted to HUB_BASE_URL/api/result/battleship. Keep both hub URLs
# empty to disable integration, or set both to enable it.
HUB_BASE_URL=

# Public HTTP(S) origin that players use to reach Battleship. It is prepended
# to controller and spectator paths returned to the hub. Keep empty when disabled.
PUBLIC_BASE_URL=
